# Copy to .env (never commit the real file). Everything below is optional; the site works with none of it.
DATABASE_URL=sqlite:///./aiub.db
AIUB_SECRET=change-me-to-a-long-random-string
ADMIN_INITIAL_PASSWORD=choose-a-strong-password
CORS_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Notice sources (leave "[]" until AIUB provides one) ---
# NOTICE_SOURCES=[{"type":"html_list","name":"aiub-notices","url":"https://www.aiub.edu/category/notices"}]   # reads one page every cycle; robots.txt always checked
# NOTICE_SOURCES=[{"type":"rss","name":"aiub-feed","url":"https://...","authorized_by":"AIUB IT, written approval 2026-12-01"}]
# NOTICE_SOURCES=[{"type":"json","name":"aiub-api","url":"https://...","items_path":"data","fields":{"title":"headline","url":"link","published":"date"},"auth_env":"AIUB_API_TOKEN"}]
# NOTICE_SOURCES=[{"type":"email","name":"email-inbox"}]
NOTICE_SOURCES=[]
NOTICE_LINK_DOMAINS=aiub.edu
ENABLE_SCHEDULER=0
SCHEDULER_INTERVAL_SEC=300
CRON_SECRET=

# --- Forwarded email webhook ---
INBOUND_EMAIL_SECRET=
INBOUND_SENDER_ALLOWLIST=
INBOUND_AUTO_PUBLISH=1

# --- Web Push: generate with  python -m app.tools.vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
